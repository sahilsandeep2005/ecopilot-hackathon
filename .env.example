# EnergyPlus installation directory.
ENERGYPLUS_HOME= C:\EnergyPlusV26-1-0

# Shared SQLite communication bus
ECOPILOT_DB=data/ecopilot.db

# Local LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_URL=http://127.0.0.1:8000/mcp

# Agent timing
AGENT_INTERVAL_SECONDS=2.0
AGENT_MAX_TOOL_ROUNDS=8

# Safety token secret. Change this before a public demo.
APPROVAL_SECRET=change-this-before-demo
APPROVAL_TOKEN_VALID_STEPS=4

# Comfort and safety constraints
OCCUPIED_TEMP_MIN_C=21.0
OCCUPIED_TEMP_MAX_C=26.0
MAX_ABS_PMV=0.7
MAX_CO2_PPM=1000
MIN_HEATING_SETPOINT_C=18.0
MAX_HEATING_SETPOINT_C=22.0
MIN_COOLING_SETPOINT_C=22.0
MAX_COOLING_SETPOINT_C=27.0
MIN_DEADBAND_C=2.0
MAX_SETPOINT_CHANGE_C=2.0

# Optional comma-separated overrides when automatic IDF discovery is imperfect.
CONTROLLED_COOLING_SCHEDULES=
CONTROLLED_HEATING_SCHEDULES=
CONTROLLED_LIGHTING_SCHEDULES=
CONTROLLED_VENTILATION_SCHEDULES=
